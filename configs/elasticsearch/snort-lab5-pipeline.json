{
  "description": "Parse syslog-ng Snort alerts and recover event time (Lab 5)",
  "processors": [
    {
      "grok": {
        "field": "message",
        "patterns": [
          "^%{SYSLOGTIMESTAMP:snort.syslog_timestamp} %{HOSTNAME:snort.hostname} %{MONTHNUM:snort.month}/%{MONTHDAY:snort.day}-%{TIME:snort.event_time}%{GREEDYDATA}"
        ]
      }
    },
    {
      "grok": {
        "field": "message",
        "patterns": [
          "%{GREEDYDATA:snort.raw_prefix}\\[\\*\\*\\] \\[Classification: %{DATA:snort.classification}\\] \\[Priority: %{INT:snort.priority}\\]%{GREEDYDATA:snort.raw_suffix}"
        ]
      }
    },
    {
      "grok": {
        "field": "snort.raw_prefix",
        "patterns": [
          "%{GREEDYDATA}\\[\\*\\*\\] \\[%{DATA:snort.rule_id}\\] %{GREEDYDATA:snort.alert_type} "
        ]
      }
    },
    {
      "grok": {
        "field": "snort.raw_suffix",
        "patterns": [
          " \\{%{DATA:snort.protocol}\\} %{IP:snort.source_ip}:%{INT:snort.source_port} -> %{IP:snort.destination_ip}:%{INT:snort.destination_port}",
          " \\{%{DATA:snort.protocol}\\} %{IP:snort.source_ip} -> %{IP:snort.destination_ip}"
        ]
      }
    },
    {"convert": {"field": "snort.priority", "type": "integer"}},
    {"convert": {"field": "snort.source_port", "type": "integer", "ignore_missing": true}},
    {"convert": {"field": "snort.destination_port", "type": "integer", "ignore_missing": true}},
    {
      "script": {
        "lang": "painless",
        "source": "def received = java.time.Instant.parse(ctx['@timestamp']); int year = received.atZone(java.time.ZoneOffset.UTC).getYear(); int month = Integer.parseInt(ctx.snort.month); int day = Integer.parseInt(ctx.snort.day); def time = java.time.LocalTime.parse(ctx.snort.event_time); def date = java.time.LocalDate.of(year, month, day); def event = date.atTime(time).toInstant(java.time.ZoneOffset.UTC); if (event.isAfter(received.plusSeconds(86400))) { event = date.minusYears(1).atTime(time).toInstant(java.time.ZoneOffset.UTC); } ctx.snort.event_timestamp = event.toString();"
      }
    },
    {"date": {"field": "snort.event_timestamp", "target_field": "snort.event_timestamp", "formats": ["ISO8601"], "timezone": "UTC"}},
    {"remove": {"field": ["snort.raw_prefix", "snort.raw_suffix", "snort.month", "snort.day", "snort.event_time"], "ignore_missing": true}}
  ],
  "on_failure": [
    {"set": {"field": "snort.parse_error", "value": "{{ _ingest.on_failure_message }}"}}
  ]
}
